"""
.env.example for Electron App
"""

# Application Settings
APP_NAME=Electron-App
APP_VERSION=1.0.0
DEBUG=True

# Electron Settings
ELECTRON_IS_DEV=true
PORT=3000

# API Settings (if connecting to backend)
# API_BASE_URL=http://localhost:8000
# BACKEND_API_URL=http://127.0.0.1:8000/api

# Feature Flags
FEATURE_TRAY=true
FEATURE_AUTO_UPDATE=true
FEATURE_PROTOCOL_HANDLER=true